# ─── App ───────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-min32
CORS_ORIGINS=["http://localhost:3000"]

# ─── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rhm:rhm@localhost:5432/rabbithole
SYNC_DATABASE_URL=postgresql://rhm:rhm@localhost:5432/rabbithole

# ─── Neo4j ───────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rabbitholepass

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Qdrant ──────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── S3 / MinIO ──────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rabbithole-blobs

# ─── LLM ─────────────────────────────────────────────────
# Required — all pipeline stages use Claude
ANTHROPIC_API_KEY=
# Optional — fallback embeddings if Voyage not set
OPENAI_API_KEY=
# Optional — preferred embeddings provider
VOYAGE_API_KEY=

# ─── Auth (Clerk) ────────────────────────────────────────
# Leave empty in development to use the synthetic dev user
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ─── Crawler API Keys (all optional — crawlers skip gracefully if missing) ──
SERPER_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RabbitHoleMapper/1.0
YOUTUBE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# ─── Observability (all optional) ────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Budgets ─────────────────────────────────────────────
MAX_COST_PER_RABBIT_HOLE=2.0
